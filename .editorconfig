# Editor settings shared by everyone working on SignalLadder.
# See https://editorconfig.org for editor support.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# GitHub Actions, issue forms and Dependabot config.
[*.{yml,yaml}]
indent_size = 2

# Two trailing spaces are a hard line break in Markdown, so leave them alone.
[*.md]
trim_trailing_whitespace = false

# The live check's fixtures are compared byte for byte, and several end without
# a newline on purpose: Scripts/harness-guards-test.sh fails a case if an editor
# adds one.
[Scripts/fixtures/**]
insert_final_newline = false
